#!/usr/bin/env bash
# claude-accounts: several Claude Code accounts, one shared configuration.
# Each account has its own CLAUDE_CONFIG_DIR (credentials, history, sessions).
# CLAUDE.md, skills, agents, commands, plugins, themes: links to ~/.claude.
# settings.json: loaded with --settings (claude refuses to write through a link).
# This script never reads credentials and makes no network requests.

set -euo pipefail

readonly SHARED_ENTRIES=(CLAUDE.md skills agents commands plugins themes)
readonly STRIPPED_ENV=(ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN)
readonly MENU_ADD='+ Add an account'
readonly MENU_REMOVE='- Remove an account'
readonly MENU_BACK='Back'
readonly MENU_QUIT='Quit'

die() {
	printf 'claude-accounts: %s\n' "$*" >&2
	exit 1
}

registry_file() {
	printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/claude-accounts/accounts"
}

accounts_root() {
	printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}/claude-accounts"
}

shared_root() {
	printf '%s\n' "$HOME/.claude"
}

account_dir() {
	printf '%s/%s\n' "$(accounts_root)" "$1"
}

is_valid_name() {
	[[ "$1" =~ ^[a-z0-9_-]{1,32}$ ]]
}

validate_name() {
	is_valid_name "$1" ||
		die "invalid name '$1': use 1 to 32 characters among a-z 0-9 _ -"
}

list_accounts() {
	local registry
	registry=$(registry_file)
	[[ -f "$registry" ]] || return 0
	grep -v '^$' "$registry" || true
}

account_exists() {
	list_accounts | grep -qxF -- "$1"
}

require_account() {
	validate_name "$1"
	account_exists "$1" || die "no such account: $1 (see: claude-accounts list)"
	[[ -d "$(account_dir "$1")" ]] ||
		die "missing directory for $1: $(account_dir "$1")"
}

has_claude() {
	command -v claude >/dev/null 2>&1
}

require_claude() {
	has_claude || die "claude not found in PATH"
}

confirm() {
	local answer
	[[ -t 0 ]] || return 1
	if has_gum; then
		gum confirm --affirmative 'Delete' --negative 'Keep' "$1"
		return
	fi
	read -r -p "$1 [y/N] " answer || return 1
	[[ "$answer" =~ ^[oOyY]$ ]]
}

cmd_add() {
	local name="$1" dir registry
	validate_name "$name"
	account_exists "$name" && die "account already exists: $name"
	dir=$(account_dir "$name")
	registry=$(registry_file)
	mkdir -p -m 700 "$(accounts_root)" "$(dirname "$registry")"
	mkdir -m 700 "$dir" 2>/dev/null || [[ -d "$dir" ]] || die "cannot create $dir"
	chmod 700 "$dir"
	link_shared "$dir"
	printf '%s\n' "$name" >>"$registry"
	printf 'Account "%s" created: %s\n' "$name" "$dir"
	printf 'First launch: claude-accounts run %s, then /login\n' "$name"
}

cmd_list() {
	local names
	names=$(list_accounts)
	if [[ -z "$names" ]]; then
		printf 'No accounts. Create one: claude-accounts add <name>\n'
		return 0
	fi
	printf '%s\n' "$names"
}

remove_from_registry() {
	local registry tmp
	registry=$(registry_file)
	tmp=$(mktemp "$registry.XXXXXX")
	grep -vxF -- "$1" "$registry" >"$tmp" || true
	mv -f -- "$tmp" "$registry"
}

cmd_remove() {
	local name="$1" dir
	validate_name "$name"
	account_exists "$name" || die "compte inexistant : $name"
	remove_from_registry "$name"
	printf 'Account "%s" removed from the list.\n' "$name"
	dir=$(account_dir "$name")
	[[ -d "$dir" ]] || return 0
	if confirm "Also delete $dir (credentials and history of this account)?"; then
		rm -rf -- "$dir"
		printf 'Directory deleted.\n'
	else
		printf 'Directory kept: %s\n' "$dir"
	fi
}

link_shared() {
	local dir="$1" shared entry
	shared=$(shared_root)
	for entry in "${SHARED_ENTRIES[@]}"; do
		[[ -e "$shared/$entry" ]] || continue
		if [[ -L "$dir/$entry" || ! -e "$dir/$entry" ]]; then
			ln -sfn -- "$shared/$entry" "$dir/$entry"
		else
			printf 'claude-accounts: %s/%s exists and is not a link, not shared\n' \
				"$dir" "$entry" >&2
		fi
	done
}

build_claude_args() {
	local settings
	settings="$(shared_root)/settings.json"
	[[ -f "$settings" ]] && printf '%s\0' --settings "$settings"
	return 0
}

claude_env_args() {
	local var
	for var in "${STRIPPED_ENV[@]}"; do
		printf '%s\0' -u "$var"
	done
}

cmd_run() {
	local name="$1" dir
	shift
	require_account "$name"
	require_claude
	dir=$(account_dir "$name")
	link_shared "$dir"
	local env_args=() claude_args=()
	mapfile -d '' env_args < <(claude_env_args)
	mapfile -d '' claude_args < <(build_claude_args)
	exec env "${env_args[@]}" CLAUDE_CONFIG_DIR="$dir" \
		claude "${claude_args[@]}" "$@"
}

subscription_type() {
	local pattern='"subscriptionType"[[:space:]]*:[[:space:]]*"([a-z_]+)"'
	[[ "$1" =~ $pattern ]] && printf '%s' "${BASH_REMATCH[1]}"
	return 0
}

is_claude_process() {
	local comm
	comm=$(ps -o comm= -p "$1" 2>/dev/null) || return 1
	[[ "${comm##*/}" == claude ]]
}

active_sessions() {
	local file pid count=0
	for file in "$(account_dir "$1")"/sessions/*.json; do
		[[ -e "$file" ]] || continue
		pid=${file##*/}
		pid=${pid%.json}
		[[ "$pid" =~ ^[0-9]+$ ]] || continue
		if is_claude_process "$pid"; then
			count=$((count + 1))
		fi
	done
	printf '%s\n' "$count"
}

account_status() {
	local env_args=() output code=0 state plan='' sessions
	sessions=$(active_sessions "$1")
	mapfile -d '' env_args < <(claude_env_args)
	output=$(env "${env_args[@]}" CLAUDE_CONFIG_DIR="$(account_dir "$1")" \
		claude auth status --json </dev/null 2>/dev/null) || code=$?
	case "$code" in
	0)
		state=logged-in
		plan=$(subscription_type "$output")
		;;
	1) state=logged-out ;;
	*) state=unknown ;;
	esac
	printf '%s\t%s\t%s\n' "$state" "$sessions" "$plan"
}

collect_statuses() {
	local tmp name i=0
	tmp=$(mktemp -d)
	for name in "$@"; do
		account_status "$name" >"$tmp/$i" &
		i=$((i + 1))
	done
	wait
	i=0
	for name in "$@"; do
		printf '%s\t%s\n' "$name" "$(<"$tmp/$i")"
		i=$((i + 1))
	done
	rm -rf -- "$tmp"
}

name_width() {
	local name width=0
	for name in "$@"; do
		if ((${#name} > width)); then
			width=${#name}
		fi
	done
	printf '%s\n' "$width"
}

state_label() {
	case "$1" in
	logged-in) printf 'logged in' ;;
	logged-out) printf 'logged out' ;;
	*) printf 'unknown' ;;
	esac
}

sessions_label() {
	if (($1 > 0)); then
		printf '%s active' "$1"
	fi
}

strip_trailing_spaces() {
	printf '%s\n' "${1%"${1##*[! ]}"}"
}

cmd_status() {
	local names=() rows=() row name state sessions plan name_w plan_w=0 line
	mapfile -t names < <(list_accounts)
	if ((${#names[@]} == 0)); then
		cmd_list
		return 0
	fi
	require_claude
	name_w=$(name_width "${names[@]}")
	mapfile -t rows < <(collect_statuses "${names[@]}")
	for row in "${rows[@]}"; do
		IFS=$'\t' read -r name state sessions plan <<<"$row"
		if ((${#plan} > plan_w)); then
			plan_w=${#plan}
		fi
	done
	for row in "${rows[@]}"; do
		IFS=$'\t' read -r name state sessions plan <<<"$row"
		line=$(printf '%-*s  %-10s  %-*s  %s' "$name_w" "$name" "$(state_label "$state")" \
			"$plan_w" "$plan" "$(sessions_label "$sessions")")
		strip_trailing_spaces "$line"
	done
}

has_gum() {
	command -v gum >/dev/null 2>&1
}

choose_with_select() {
	local header="$1" choice
	shift
	printf '%s\n' "$header" >&2
	PS3='Choice: '
	select choice in "$@"; do
		if [[ -n "$choice" ]]; then
			printf '%s\n' "$choice"
			return 0
		fi
		printf 'Invalid choice.\n' >&2
	done
	return 1
}

choose_entry() {
	local header="$1"
	shift
	if has_gum; then
		gum choose \
			--header "$header" \
			--height 12 \
			--cursor '› ' \
			--cursor.foreground '#89b4fa' \
			--header.foreground '#a6e3a1' \
			-- \
			"$@"
	else
		choose_with_select "$header" "$@"
	fi
}

read_new_name() {
	local name
	if has_gum; then
		gum input \
			--header 'New account name' \
			--placeholder 'e.g. personal or work' \
			--char-limit 32 \
			--prompt '› '
	else
		read -r -p 'New account name (a-z, 0-9, _ and -): ' name && printf '%s\n' "$name"
	fi
}

show_message() {
	if has_gum; then
		gum style --foreground '#f38ba8' "$*" >&2
	else
		printf 'claude-accounts: %s\n' "$*" >&2
	fi
}

add_from_menu() {
	local name
	while :; do
		name=$(read_new_name) || return 0
		[[ -n "$name" ]] || return 0
		if ! is_valid_name "$name"; then
			show_message 'Invalid name: use 1 to 32 characters among a-z, 0-9, _ and -.'
			continue
		fi
		if account_exists "$name"; then
			show_message "Account '$name' already exists."
			continue
		fi
		cmd_add "$name"
		cmd_run "$name"
	done
}

menu_header() {
	local count="$1" label
	if ((count == 0)); then
		label='No accounts yet'
	elif ((count == 1)); then
		label='1 account ready to launch'
	else
		label="$count accounts ready to launch"
	fi
	printf 'claude-accounts\n%s\n\nChoose an account to open Claude in this terminal.' "$label"
}

menu_badge() {
	local state="$1" sessions="$2" plan="$3" badge
	case "$state" in
	logged-in) badge="logged in${plan:+ · $plan}" ;;
	logged-out) badge='logged out' ;;
	*) badge='status unknown' ;;
	esac
	if ((sessions > 0)); then
		badge+=" · $sessions active"
	fi
	printf '%s' "$badge"
}

menu_labels() {
	local width name state sessions plan
	(($# > 0)) || return 0
	if ! has_claude; then
		printf '%s\n' "$@"
		return 0
	fi
	width=$(name_width "$@")
	while IFS=$'\t' read -r name state sessions plan; do
		printf '%-*s  %s\n' "$width" "$name" "$(menu_badge "$state" "$sessions" "$plan")"
	done < <(collect_statuses "$@")
}

remove_from_menu() {
	local name
	(($# > 0)) || return 0
	name=$(choose_entry $'Remove an account\n\nCredentials and history can be kept.' \
		"$@" "$MENU_BACK") || return 0
	[[ "$name" == "$MENU_BACK" ]] && return 0
	cmd_remove "$name"
}

cmd_menu() {
	[[ -t 0 && -t 1 ]] || die "the menu needs an interactive terminal"
	local names=() labels=() choices=() choice
	while :; do
		mapfile -t names < <(list_accounts)
		mapfile -t labels < <(menu_labels "${names[@]}")
		choices=("${labels[@]}" "$MENU_ADD")
		((${#names[@]} > 0)) && choices+=("$MENU_REMOVE")
		choices+=("$MENU_QUIT")
		choice=$(choose_entry "$(menu_header "${#names[@]}")" "${choices[@]}") || return 0
		case "$choice" in
		"$MENU_ADD") add_from_menu ;;
		"$MENU_REMOVE") remove_from_menu "${names[@]}" ;;
		"$MENU_QUIT") return 0 ;;
		*) cmd_run "${choice%% *}" ;;
		esac
	done
}

usage() {
	cat <<'EOF'
Usage:
  claude-accounts                   menu: pick an account and start claude here
  claude-accounts add <name>        create the account and its directory (700)
  claude-accounts list              list accounts
  claude-accounts status            show login status, plan and active sessions of each account
  claude-accounts remove <name>     remove the account (directory deleted only if confirmed)
  claude-accounts run <name> [...]  start claude with this account here (args passed to claude)
EOF
}

require_arg() {
	[[ -n "${1:-}" ]] || { usage >&2; exit 1; }
}

main() {
	umask 077
	case "${1:-}" in
	'') cmd_menu ;;
	add) require_arg "${2:-}"; cmd_add "$2" ;;
	list) cmd_list ;;
	status) cmd_status ;;
	remove) require_arg "${2:-}"; cmd_remove "$2" ;;
	run) require_arg "${2:-}"; shift; cmd_run "$@" ;;
	-h | --help | help) usage ;;
	*) usage >&2; exit 1 ;;
	esac
}

main "$@"
